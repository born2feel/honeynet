# Required when the dashboard is reachable by anyone but you.
HONEYNET_DASHBOARD_TOKEN=change-me-to-a-long-random-string
# Free GeoLite2 City database from https://www.maxmind.com/en/geolite2/signup,
# placed in ./geoip/ next to docker-compose.yml.
HONEYNET_GEOIP_DB=/geoip/GeoLite2-City.mmdb
# Hostname the fake shell reports.
HONEYNET_HOSTNAME_FAKE=srv-prod-01
HONEYNET_RETENTION=30d
HONEYNET_LOG_LEVEL=info
